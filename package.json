{
  "name": "combined-bots-project",
  "version": "1.0.0",
  "description": "Running two bots with Firebase integration on Render",
  "main": "bot.js",
  "scripts": {
    "install-all": "npm install",
    "bot1": "node bot.js",
    "bot2": "node bot2.js",
    "start": "concurrently --kill-others \"node bot.js\" \"node bot2.js\""
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "firebase-admin": "^12.0.0",
    "firebase": "^10.8.0",
    "dotenv": "^16.4.5",
    "discord.js": "^14.14.1",
    "telegraf": "^4.15.3",
    "node-fetch": "^3.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
